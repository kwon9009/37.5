DATABASE_URL=mysql+pymysql://user:password@localhost:3306/human_exe
# @는 사용자 정보와 호스트를 구분하는 예약 문자이기 때문에 %40 으로 대체

SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ALIGO_API_KEY=

# 비밀번호 재설정 메일 (Gmail SMTP)
# MAIL_USERNAME / MAIL_PASSWORD 를 비워두면 메일을 보내지 않고
# 서버 로그에 재설정 링크만 출력한다. 메일 계정 없이도 개발/테스트가 된다.
#
# MAIL_PASSWORD 는 Gmail 로그인 비밀번호가 아니라 '앱 비밀번호' 16자리다.
# 발급: https://myaccount.google.com/apppasswords  (2단계 인증이 켜져 있어야 보임)
# 넣을 때는 띄어쓰기를 빼고 붙여넣는다. 예) abcdefghijklmnop
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=37.5 SmartCare

# 재설정 링크 앞에 붙일 주소. 배포하면 실제 도메인으로 바꾼다.
FRONTEND_BASE_URL=http://localhost:5173

# 재설정 링크 유효시간(분)
PASSWORD_RESET_EXPIRE_MINUTES=30

# 센서 오류 판별용 생리학적 한계값 (이 범위를 벗어난 측정은 버림)
# 등급 판정 기준(NEWS2)과는 별개로, 오측정만 거르는 용도
PLAUSIBLE_HR_MIN=25
PLAUSIBLE_HR_MAX=220
PLAUSIBLE_RR_MIN=5
PLAUSIBLE_RR_MAX=50

# 호흡 급변(센서 오측정) 판정: 1초 사이에 이만큼 이상 변하면 그 호흡값은 버린다
RESP_MAX_JUMP=6
RESP_JUMP_WINDOW_SEC=5

# 조기경보(이상탐지 예측 모델) 사용 여부.
# false로 두면 NEWS2 규칙 판정만 쓴다. 조기경보는 등급을 올리기만 하므로
# 꺼도 기존 판정·응급 감지는 그대로 동작한다.
#
# 지금은 꺼둔다. 현재 모델은 정상 생체값에도 "정상"을 내지 못해서
# 켜면 화면이 주의·경고로 뒤덮인다. 실측 데이터로 재학습한 뒤 다시 켠다.
EARLY_WARNING_ENABLED=false

# 응급 로그를 남기기 전에 DANGER가 이만큼(초) 이어져야 한다 (센서 순간 튐 방지)
DANGER_SUSTAIN_SEC=10

# 실시간 스트림(SSE) 접속 티켓 유효시간(초)
STREAM_TICKET_TTL_SEC=60

# 실측 기록 파일 경로. 비워두면 기록하지 않는다(평소 기본값).
# 1초 원시값은 DB에 쌓지 않으므로, 실측 후 규칙 판정과 예측 모델을 비교하려면
# 측정하는 동안에만 켜둬야 한다. 켠 뒤 분석:
#   PYTHONPATH=. python scripts/analyze_vital_record.py records/session1.ndjson
VITAL_RECORD_PATH=