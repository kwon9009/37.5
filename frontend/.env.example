# Vite는 VITE_ 접두사가 붙은 변수만 읽습니다
VITE_API_URL=http://localhost:8000

# 카카오맵 JavaScript 키 (보호자 앱 병원 위치 지도)
# developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼 > Web 에 사이트 도메인 등록 필요 (로컬: http://localhost:5173)
# 비워두면 지도 대신 주소만 표시됩니다.
VITE_KAKAO_MAP_KEY=

# 그래프 눈금 단위. 비워두면 시간 단위(하루 00~23시)로 그립니다.
# 시연 영상처럼 짧게 측정해서 선을 보여줘야 할 때만 minute 으로 바꾸세요.
# minute = 최근 60분을 1분 단위로 표시 (10분만 재도 점 10개 -> 선이 그려짐)
VITE_CHART_BUCKET=
